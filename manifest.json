{
	"manifest_version": 3,
	"name": "Quick URL Copy",
	"version": "1.0.0",
	"description": "Collect and copy URLs from open tabs.",
	"minimum_chrome_version": "109",
	"permissions": [
		"tabs",
		"storage",
		"clipboardWrite",
		"offscreen"
	],
	"background": {
		"service_worker": "src/background/service-worker.js",
		"type": "module"
	},
	"action": {
		"default_title": "Quick URL Copy"
	},
	"options_ui": {
		"page": "src/options/options.html",
		"open_in_tab": false
	},
	"commands": {
		"copy-current-tab": {
			"suggested_key": {
				"default": "Alt+Shift+1"
			},
			"description": "Copy active tab URL"
		},
		"copy-window-tabs": {
			"suggested_key": {
				"default": "Alt+Shift+2"
			},
			"description": "Copy URLs from the current window"
		},
		"copy-group-tabs": {
			"suggested_key": {
				"default": "Alt+Shift+3"
			},
			"description": "Copy URLs from the same tab group"
		},
		"copy-all-tabs": {
			"suggested_key": {
				"default": "Alt+Shift+4"
			},
			"description": "Copy URLs from all tabs"
		}
	},
	"icons": {
		"48": "assets/icons/icon48.png"
	}
}
