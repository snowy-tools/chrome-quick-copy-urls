{
	"manifest_version": 3,
	"name": "Quick URL Copy",
	"version": "1.0.0",
	"description": "Collect and copy URLs from the active tab, current window, or all tabs.",
	"minimum_chrome_version": "109",
	"permissions": [
		"tabs",
		"storage",
		"clipboardWrite",
		"offscreen"
	],
	"background": {
		"service_worker": "service-worker.js",
		"type": "module"
	},
	"action": {
		"default_title": "Quick URL Copy",
		"default_popup": "popup.html"
	},
	"options_ui": {
		"page": "options.html",
		"open_in_tab": false
	},
	"commands": {
		"copy-current-tab": {
			"suggested_key": {
				"default": "Alt+Shift+1"
			},
			"description": "Copy active tab URL"
		},
		"copy-window-tabs": {
			"suggested_key": {
				"default": "Alt+Shift+2"
			},
			"description": "Copy URLs from tabs in the current window"
		},
		"copy-all-tabs": {
			"suggested_key": {
				"default": "Alt+Shift+3"
			},
			"description": "Copy URLs from all tabs"
		}
	},
	"icons": {
		"48": "icons/icon48.png"
	}
}
